<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
             xmlns:local="clr-namespace:ComfyPromptViewer"
             x:Class="ComfyPromptViewer.GalleryView"
             x:DataType="local:GalleryViewModel">
    <Panel>
        <ScrollViewer Name="GalleryScrollViewer"
                      VerticalScrollBarVisibility="Visible"
                      ScrollChanged="GalleryScrollViewer_ScrollChanged">
            <!-- Width is set to whole columns by UpdateGalleryWidth, so centering moves the grid as one
                 block and a short last row stays aligned with the columns above it. -->
            <ir:ItemsRepeater Name="GalleryItems" ItemsSource="{Binding Items}" Margin="10" HorizontalAlignment="Center">
                <ir:ItemsRepeater.Layout>
                    <layout:UniformGridLayout MinItemWidth="212"
                                               MinItemHeight="212"
                                               MinColumnSpacing="0"
                                               MinRowSpacing="0" />
                </ir:ItemsRepeater.Layout>
                <ir:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ImageItem">
                        <Border Classes="card"
                                Classes.selected="{Binding IsMarkedSelected}"
                                Classes.active="{Binding IsSelected}"
                                Width="{DynamicResource GalleryTileSize}"
                                Height="{DynamicResource GalleryTileSize}"
                                Padding="2"
                                Margin="8"
                                PointerPressed="GalleryItem_PointerPressed"
                                 KeyDown="GalleryItem_KeyDown"
                                 AutomationProperties.Name="{Binding FileName, Mode=OneTime}"
                                 Focusable="True">
                            <Border.ContextMenu>
                                <ContextMenu Opening="ContextMenu_Opening">
                                    <MenuItem Header="Open in File Explorer" Tag="open" Click="ContextMenuItem_Click" />
                                    <MenuItem Header="Copy Prompt" Tag="prompt" Click="ContextMenuItem_Click" IsEnabled="{Binding HasPrompt}" />
                                    <MenuItem Header="Copy Negative Prompt" Tag="negative" Click="ContextMenuItem_Click" IsEnabled="{Binding HasNegativePrompt}" />
                                    <MenuItem Header="Copy Image Path" Tag="path" Click="ContextMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete Image" Tag="delete" Click="ContextMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Panel>
                                <Border Classes="skeleton"
                                        CornerRadius="2"
                                        IsVisible="{Binding IsLoading}" />
                                <TextBlock Text="Needs VLC"
                                           Classes="muted"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding NeedsVlc}" />

                                 <!-- Composition implicit animation rather than a DoubleTransition:
                                      a screen of tiles fading in is interpolated on the render
                                      thread instead of competing with thumbnail dispatch on the
                                      UI thread. -->
                                 <Border Background="Transparent"
                                         CornerRadius="2"
                                         ClipToBounds="True"
                                         local:CompositionFade.Duration="0:0:0.10"
                                         Opacity="{Binding ThumbnailOpacity}">
                                     <Image Source="{Binding Preview}"
                                            RenderOptions.BitmapInterpolationMode="LowQuality"
                                            Stretch="Uniform"
                                            HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>

                                <!-- Sits on the image, not the theme surface, so a fixed scrim reads on any thumbnail. -->
                                <Border IsVisible="{Binding IsVideo, Mode=OneTime}"
                                        Background="#99000000"
                                        CornerRadius="3"
                                        Padding="5,4,4,4"
                                        Margin="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False">
                                    <Path Data="M0,0 L7,4 L0,8 Z" Fill="White" />
                                </Border>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ir:ItemsRepeater.ItemTemplate>
            </ir:ItemsRepeater>
        </ScrollViewer>

        <!-- Gallery Empty State (Search Results) -->
        <StackPanel Name="GalleryEmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    IsVisible="False"
                    Opacity="0">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </StackPanel.Transitions>
            <TextBlock Text="No matching images"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource FontHeading}"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       FontWeight="Medium" />
            <TextBlock Text="Try adjusting your search terms or exclusions."
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Panel>
</UserControl>
