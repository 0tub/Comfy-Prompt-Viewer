<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
        xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComfyPromptViewer"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="ComfyPromptViewer.MainWindow"
        x:DataType="local:GalleryViewModel"
        Icon="/Assets/app.ico"
        Title="Comfy Prompt Viewer"
        Width="1180"
        Height="780"
        MinWidth="860"
        MinHeight="560"
        FontFamily="{DynamicResource FontUI}"
        Background="{DynamicResource BackgroundBase}">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.secondary-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.zoom-btn">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="0" />
             <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.zoom-btn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.zoom-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.zoom-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.danger-action">
            <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DangerText}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.danger-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBorder}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button.preview-nav-btn">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Opacity" Value="0.34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.preview-nav-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.preview-nav-btn:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.preview-nav-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.preview-nav-btn:disabled">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="BoxShadow" Value="0 4 10 0 #40000000" />
        </Style>
        <!-- Selected tiles take the bright accent so they read against busy thumbnails; the active tile (the
             sidebar target) is lighter still, so it stays findable inside a multi-selection. -->
        <Style Selector="Border.card.selected, Border.card.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextAccent}" />
        </Style>
        <Style Selector="Border.card.active, Border.card.active:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Sidebar values that search for other images sharing them. -->
        <Style Selector="TextBlock.sidebar-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.search-link">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBlock.search-link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <!-- Search terms found in the sidebar prompts. -->
        <Style Selector="Run.search-hit">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="Path.line-icon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        
        <Style Selector="Button.close-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.close-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!-- A drawn cross for close buttons: the text multiplication-x falls back to another font and stretches. -->
        <Style Selector="Path.close-icon">
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.close-btn:pointerover Path.close-icon">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.close-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button.clear-search-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.clear-search-btn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.clear-search-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button.search-help-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.search-help-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.search-help-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button.search-help-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="ComboBox.search-scope-combo">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.search-scope-combo:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Border.search-shell">
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.search-shell:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}" />
        </Style>
        <Style Selector="Border.search-shell:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>

        <Style Selector="Border.skeleton">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBox.search-box">
            <Setter Property="Padding" Value="6,5,8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="WatermarkForeground" Value="{DynamicResource TextMuted}" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource BorderAccent}" />
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Slider /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource TextAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextAccent}" />
        </Style>
        <Style Selector="Slider:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource TextAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextAccent}" />
        </Style>
        <Style Selector="Slider /template/ Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="Slider:pressed /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
        </Style>
        
        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderAccent}" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton:pressed">
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
        </Style>
        
        <Style Selector="Border.toolbar-group">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        
        <!-- Status, not a control, so no button-like frame. -->
        <Style Selector="Border.count-pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Border.count-pill TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        
        
        <Style Selector="StackPanel#SidebarMetadataPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#MenuErrorBanner">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock#CountText">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="ToggleButton.flat-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.flat-toggle TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.flat-toggle:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="ToggleButton.subfolder-toggle">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F2E23" />
            <Setter Property="BorderBrush" Value="#3A5E43" />
            <Setter Property="Foreground" Value="#A3D9B1" />
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#293C2E" />
            <Setter Property="BorderBrush" Value="#4B7A57" />
            <Setter Property="Foreground" Value="#BAE8C6" />
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#17221A" />
            <Setter Property="BorderBrush" Value="#2F4C36" />
            <Setter Property="Foreground" Value="#86B593" />
        </Style>
        <Style Selector="ToggleButton.subfolder-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button#BackButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Button#BackButton /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#BackButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Button#BackButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button.menu-action-btn">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.menu-action-btn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.menu-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.menu-action-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Border.recent-item">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.recent-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}" />
        </Style>
        <Style Selector="Border.recent-item.missing">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- Pin and remove stay out of the way until the row is hovered or focused; a pinned row keeps its pin. -->
        <Style Selector="Border.recent-item Button.recent-action">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.recent-item:pointerover Button.recent-action, Border.recent-item:focus-within Button.recent-action">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.recent-item Button.recent-action.pinned">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.recent-action.pinned Path.line-icon">
            <Setter Property="Stroke" Value="{DynamicResource TextAccent}" />
        </Style>

        <Style Selector="Button.menu-corner-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.menu-corner-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button.menu-maintenance-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.menu-maintenance-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.menu-maintenance-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="ToggleButton.advanced-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="ToggleButton.advanced-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.advanced-toggle:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="FlyoutPresenter.shortcuts-flyout">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <local:HeaderView Name="Header" IsVisible="False" />

        <Grid Name="MainGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <!-- Index 2 in MainGrid.ColumnDefinitions; MainWindow.SidebarColumn resolves it. -->
                <ColumnDefinition Width="380" MinWidth="260" MaxWidth="560" />
            </Grid.ColumnDefinitions>
            <local:GalleryView Name="Gallery" Grid.Column="0" />

            <GridSplitter Name="SidebarSplitter"
                          Grid.Column="1"
                          Width="6"
                          MinWidth="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast"
                          AutomationProperties.Name="Resize metadata sidebar" />

            <local:SidebarView Name="Sidebar" Grid.Column="2" />

        <local:StartMenuView Name="StartMenu" Grid.ColumnSpan="3" />

        <local:LargePreviewView Name="LargePreview" Grid.Column="0" IsVisible="False" />

        <Border Name="DeleteConfirmationOverlay"
                Grid.ColumnSpan="3"
                IsVisible="False"
                Background="{DynamicResource LargePreviewOverlayBackground}">
            <Border Width="390"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="3"
                    BoxShadow="0 8 24 0 #60000000"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto">
                    <Border Grid.Row="0"
                            Padding="16,12"
                            Background="{DynamicResource SurfaceElevated}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Name="DeleteConfirmationTitle"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="16" Spacing="14">
                        <TextBlock Name="DeleteConfirmationText"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="Cancel"
                                    Classes="secondary-action"
                                    Tag="cancel"
                                    Click="DeleteConfirmationButton_Click" />
                            <Button Name="ConfirmDeleteButton"
                                    Content="Delete"
                                    Classes="danger-action"
                                    Tag="delete"
                                    Click="DeleteConfirmationButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        </Grid>
    </Grid>
</Window>
