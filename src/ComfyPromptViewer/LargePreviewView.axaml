<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ComfyPromptViewer"
             x:Class="ComfyPromptViewer.LargePreviewView"
             x:DataType="local:LargePreviewViewModel">
    <UserControl.Styles>
        <!-- Icons come from styles, not a local Data value, so the state classes below can swap them. -->
        <Style Selector="Path.play-pause">
            <Setter Property="Data" Value="{x:Static local:LineIcons.Pause}" />
        </Style>
        <Style Selector="Path.play-pause.paused">
            <Setter Property="Data" Value="{x:Static local:LineIcons.Play}" />
        </Style>
        <Style Selector="Path.mute-state">
            <Setter Property="Data" Value="{x:Static local:LineIcons.Volume}" />
        </Style>
        <Style Selector="Path.mute-state.off">
            <Setter Property="Data" Value="{x:Static local:LineIcons.Muted}" />
        </Style>
    </UserControl.Styles>
    <Border Name="Overlay"
        Background="{DynamicResource LargePreviewOverlayBackground}"
        PointerPressed="Overlay_PointerPressed">
        <Border Background="{DynamicResource SurfaceCard}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="3"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="32"
                MinWidth="420"
                MinHeight="360"
                MaxWidth="900"
                MaxHeight="650">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource FontUI}"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Its own line, so nothing sits beside the size text to be pushed when that text changes. -->
                            <TextBlock Text="{Binding Hint}"
                                       Classes="muted"
                                       FontSize="11"
                                       Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                             <Button                                          Classes="zoom-btn"
                                     Content="Fit"
                                     FontSize="12"
                                     AutomationProperties.Name="Fit image to preview"
                                     ToolTip.Tip="Fit image"
                                     Click="FitButton_Click" />
                             <Button                                          Classes="zoom-btn"
                                     Content="1:1"
                                     FontSize="12"
                                     AutomationProperties.Name="Show image at actual size"
                                     ToolTip.Tip="Actual size"
                                     Click="ActualSizeButton_Click" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="close-btn"
                                AutomationProperties.Name="Close preview"
                                ToolTip.Tip="Close preview"
                                Command="{Binding CloseCommand}">
                            <!-- Drawn, not a text glyph: the font fallback for the multiplication-x character stretched it
                                 vertically. Colours come from the styles above, because the hover colour is set on the
                                 button's template presenter, which a binding from here cannot reach. -->
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="close-icon" Data="{x:Static local:LineIcons.Close}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Name="ImageHost"
                        Background="{DynamicResource SurfaceBase}"
                        Padding="16"
                        MinHeight="300"
                        SizeChanged="ImageHost_SizeChanged">
                    <Grid>
                        <Canvas Name="ImageCanvas"
                                ClipToBounds="True"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                PointerWheelChanged="Canvas_PointerWheelChanged"
                                PointerPressed="Canvas_PointerPressed"
                                PointerMoved="Canvas_PointerMoved"
                                PointerReleased="Canvas_PointerReleased"
                                PointerCaptureLost="Canvas_PointerCaptureLost"
                                Pinch="Canvas_Pinch"
                                PinchEnded="Canvas_PinchEnded">
                            <!-- Pinch is only raised for elements that opt in with a recognizer. -->
                            <Canvas.GestureRecognizers>
                                <PinchGestureRecognizer />
                            </Canvas.GestureRecognizers>
                            <Canvas.ContextMenu>
                                <ContextMenu Opening="ContextMenu_Opening">
                                    <MenuItem Header="Open in File Explorer" Tag="open" Click="ContextMenuItem_Click" />
                                    <MenuItem Header="Copy Prompt" Tag="prompt" Click="ContextMenuItem_Click" />
                                    <MenuItem Name="CopyNegativeMenuItem" Header="Copy Negative Prompt" Tag="negative" Click="ContextMenuItem_Click" />
                                    <MenuItem Header="Copy Image Path" Tag="path" Click="ContextMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete Image" Tag="delete" Click="ContextMenuItem_Click" />
                                </ContextMenu>
                            </Canvas.ContextMenu>
                            <Image Name="PreviewImage"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Stretch="Fill" />
                        </Canvas>
                        <Button Classes="preview-nav-btn"
                                Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                Content="&#x2039;"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                AutomationProperties.Name="Previous image" />
                        <Button Classes="preview-nav-btn"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                Content="&#x203A;"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                AutomationProperties.Name="Next image" />
                    </Grid>
                </Border>

                <!-- Not focusable: keys stay with the window, so Space pauses once and arrows keep navigating. -->
                <Border Grid.Row="2"
                        IsVisible="{Binding IsVideoControlsVisible}"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="zoom-btn"
                                Command="{Binding TogglePauseCommand}"
                                Focusable="False"
                                AutomationProperties.Name="Play or pause video"
                                ToolTip.Tip="Play / pause (Space)">
                            <!-- A fixed 24x24 canvas centers each icon by its grid, not its own bounds. A stretched Path
                                 pinned the narrow pause glyph to the left of its box. Fill follows the button's foreground,
                                 so hover highlights it like the other buttons. -->
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="play-pause"
                                          Classes.paused="{Binding IsPaused}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Slider Grid.Column="1"
                                Name="PositionSlider"
                                Minimum="0"
                                Maximum="1"
                                Focusable="False"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Video position"
                                ValueChanged="PositionSlider_ValueChanged" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TimeText}"
                                   Classes="muted"
                                   FontFamily="{DynamicResource FontMono}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Classes="zoom-btn"
                                Command="{Binding ToggleMuteCommand}"
                                Focusable="False"
                                AutomationProperties.Name="Mute or unmute video"
                                ToolTip.Tip="{Binding MuteTip}">
                            <!-- A fixed 24x24 canvas, so the speaker stays the same size in both states. -->
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="mute-state"
                                          Classes.off="{Binding IsMuted}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Slider Grid.Column="4"
                                Name="VolumeSlider"
                                Width="84"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                Focusable="False"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Video volume"
                                ToolTip.Tip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
