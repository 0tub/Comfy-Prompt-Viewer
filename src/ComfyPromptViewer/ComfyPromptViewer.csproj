<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.9.0</Version>
    <!-- Avalonia 12 ships net10.0 and net8.0 assets; net9.0 silently resolved the net8.0 ones. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- LiteDB emits an assembly-level trim warning; MetadataIndex uses explicit BsonDocument mapping and is covered by ComfyPromptViewer.Tests. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <!-- Self-contained builds embed exactly this runtime, so THIRD-PARTY-NOTICES.md can name it. When bumping it,
       replace third-party/DotNet-Runtime-THIRD-PARTY-NOTICES.txt with the new runtime pack's
       THIRD-PARTY-NOTICES.TXT and update the version in THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Linked from the repo root so the About dialog and the published files never diverge. -->
    <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Legal\LICENSE" />
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="Assets\Legal\THIRD-PARTY-NOTICES.md" />
    <AvaloniaResource Include="..\..\third-party\SkiaSharp-HarfBuzzSharp-THIRD-PARTY-NOTICES.txt" Link="Assets\Legal\SkiaSharp-HarfBuzzSharp-THIRD-PARTY-NOTICES.txt" />
    <AvaloniaResource Include="..\..\third-party\DotNet-Runtime-THIRD-PARTY-NOTICES.txt" Link="Assets\Legal\DotNet-Runtime-THIRD-PARTY-NOTICES.txt" />
    <InternalsVisibleTo Include="ComfyPromptViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <!-- Managed wrapper only; libvlc itself comes from the user's VLC install (see VideoPlayback.cs). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
  </ItemGroup>
</Project>
